---
import Base from '@/layouts/Base.astro';
import { ruta } from '@/lib/ruta';
---

<Base
  titulo="Página no encontrada"
  descripcion="La página que buscas no existe o se ha movido."
  noindex={true}
>
  <section class="contenedor py-24 text-center">
    <p class="etiqueta-suelta text-coral-700">Error 404</p>
    <h1 class="mt-5 text-titulo text-navy">Esta página no existe</h1>
    <p class="prosa mx-auto mt-5 text-lg">
      Puede que el enlace esté roto o que la página se haya movido. Sigue desde aquí:
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={ruta("/")} class="cta">Ir al inicio</a>
      <a href={ruta("/grados/")} class="cta-secundario">Ver los grados</a>
    </div>
  </section>
</Base>
