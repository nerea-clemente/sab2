---
import { getCollection } from 'astro:content';
import { ruta } from '@/lib/ruta';
import Base from '@/layouts/Base.astro';
import CabeceraPagina from '@/components/CabeceraPagina.astro';
import CtaFinal from '@/components/CtaFinal.astro';
import Icono from '@/components/Icono.astro';
import { tono } from '@/lib/areas';

const guias = (await getCollection('guias', ({ data }) => !data.borrador))
  .sort((a, b) => a.data.orden - b.data.orden);
---

<Base
  titulo="Estudiar en Dinamarca, explicado desde Dinamarca"
  tituloSeo="Estudiar en Dinamarca: guías prácticas"
  descripcion="Admisión, SU, alojamiento, coste de vida, trabajo y primeros trámites. Lo que necesitas saber para valorar la opción y entender cómo funciona el proceso."
>
  <section class="contenedor pb-4 pt-12 lg:pt-16">
    <CabeceraPagina
      etiqueta="Guías"
      titulo="Estudiar en Dinamarca, explicado desde Dinamarca"
  tituloSeo="Estudiar en Dinamarca: guías prácticas"
      lead="Admisión, SU, alojamiento, coste de vida, trabajo y primeros trámites. Lo que necesitas saber para valorar la opción y entender cómo funciona el proceso."
    >
      <Fragment slot="titulo">Estudiar en Dinamarca, explicado <span class="text-coral">desde Dinamarca</span></Fragment>
    </CabeceraPagina>
  </section>

  <section class="contenedor ritmo">
    <!-- Antes de decidir -->
    <h2 class="text-h2 text-navy">Antes de decidir</h2>
    <div class="mt-7 grid gap-4 sm:grid-cols-2">
      <a href={ruta('/para-estudiantes/')} class="tarjeta-color group bg-navy text-white">
        <span class="pastilla text-amarillo">Para estudiantes</span>
        <p class="mt-3 text-h3 text-white">Cómo se estudia</p>
        <p class="mt-2 text-sm text-white/70">Qué opciones hay y qué cambia respecto a estudiar en España.</p>
        <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-extrabold text-amarillo">
          Entrar
          <Icono nombre="flecha" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" />
        </span>
      </a>
      <a href={ruta('/para-familias/')} class="tarjeta-color group bg-cielo">
        <span class="pastilla">Para familias</span>
        <p class="mt-3 text-h3 text-navy">Las preguntas prácticas</p>
        <p class="mt-2 text-sm text-navy/70">Costes, ayudas, alojamiento, sanidad y lo que conviene resolver antes de empezar.</p>
        <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-extrabold text-azul">
          Entrar
          <Icono nombre="flecha" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" />
        </span>
      </a>
    </div>

    <!-- Guías -->
    <h2 class="mt-16 text-h2 text-navy">Guías</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {guias.map((g, i) => (
        <li class="reveal">
          <a href={ruta(`/estudiar-en-dinamarca/${g.id}/`)} class:list={['tarjeta-color group overflow-hidden !p-0', tono(i)]}>
            {g.data.imagen && (
              <img
                src={ruta(`/img/${g.data.imagen}-640.webp`)}
                alt=""
                loading="lazy"
                decoding="async"
                class="aspect-[3/2] w-full object-cover"
              />
            )}
            <div class="flex flex-1 flex-col p-6 sm:p-7">
            <span class="fecha-mono text-sm font-medium text-navy/70">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-h3 text-navy">{g.data.titulo}</h3>
            <p class="mt-2.5 text-sm text-navy/75">{g.data.descripcion}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-extrabold text-azul">
              Leer la guía
              <span class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
            </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <CtaFinal
    titulo="¿Dudas con tu caso concreto?"
    texto="La primera sesión es gratuita. Revisamos tu perfil, los requisitos que te afectan y cómo sería el proceso."
  />
</Base>
