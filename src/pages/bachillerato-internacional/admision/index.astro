---
import Base from '@/layouts/Base.astro';
import CabeceraPagina from '@/components/CabeceraPagina.astro';
import CtaFinal from '@/components/CtaFinal.astro';
import Itinerario from '@/components/Itinerario.astro';
import { ruta } from '@/lib/ruta';

const pasos = [
  { t: 'Revisamos estudios previos', d: 'Curso actual, expediente, asignaturas, edad y sistema educativo.' },
  { t: 'Revisamos inglés', d: 'El programa se estudia en inglés y los centros esperan capacidad para seguir trabajo académico.' },
  { t: 'Elegimos vía y centro', d: 'Pre-IB o IB1; Grenaa, Nyborg o ambas solicitudes cuando tenga sentido.' },
  { t: 'Preparamos documentos', d: 'Notas, referencias, motivación, identificación y traducciones juradas necesarias.' },
  { t: 'Solicitamos el internado', d: 'La plaza académica y el alojamiento requieren pasos propios.' },
  { t: 'Seguimos el proceso', d: 'Controlamos checklist, comunicaciones y decisiones junto al estudiante y la familia.' },
];
---

<Base
  titulo="Admisión al IB en Dinamarca"
  tituloSeo="Admisión al IB en Dinamarca"
  descripcion="Cómo funciona la admisión a Pre-IB y al IB Diploma en Grenaa y Nyborg: qué se revisa, cómo se elige la vía, qué documentación hace falta y cómo se solicita el internado."
>
  <section class="contenedor pb-4 pt-12 lg:pt-16">
    <CabeceraPagina
      etiqueta="Admisión"
      titulo="Primero decidimos dónde debes entrar. Después preparamos la solicitud."
      lead="La primera decisión no es Grenaa o Nyborg. Es si tu formación previa encaja con Pre-IB o con acceso directo a IB1."
    >
      <Fragment slot="titulo">Primero decidimos <span class="text-coral">dónde</span> debes entrar. Después preparamos la solicitud.</Fragment>
    </CabeceraPagina>
  </section>

  <section class="contenedor ritmo">
    <div class="max-w-3xl">
      <Itinerario pasos={pasos} flechaFinal />
    </div>
    <a href={ruta('/contacto/')} class="cta mt-12">Revisar mis requisitos <span aria-hidden="true">→</span></a>
  </section>

  <section aria-labelledby="centros" class="bg-hueso">
    <div class="contenedor ritmo">
      <h2 id="centros" class="text-h2 text-navy">Cada centro tiene su propio proceso</h2>
      <p class="mt-5 max-w-prosa text-lg text-slate">
        Los formularios, los plazos y la documentación no son los mismos en Grenaa que
        en Nyborg, y la solicitud al internado va separada de la académica.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={ruta('/bachillerato-internacional/grenaa-gymnasium/')} class="cta-secundario">Cómo se solicita en Grenaa</a>
        <a href={ruta('/bachillerato-internacional/nyborg-gymnasium/')} class="cta-secundario">Cómo se solicita en Nyborg</a>
      </div>
    </div>
  </section>

  <CtaFinal
    etiqueta=""
    titulo="¿Pre-IB o IB1? Lo miramos con tu expediente"
    texto="No usamos equivalencias automáticas. La primera sesión es gratuita y sirve justo para eso: ver qué vía te corresponde antes de preparar nada."
    cta="Reservar primera sesión"
  />
</Base>
