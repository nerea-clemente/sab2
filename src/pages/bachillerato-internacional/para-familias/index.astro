---
import Base from '@/layouts/Base.astro';
import CabeceraPagina from '@/components/CabeceraPagina.astro';
import CtaFinal from '@/components/CtaFinal.astro';
import JsonLd from '@/components/JsonLd.astro';
import { ruta } from '@/lib/ruta';
import { SITIO } from '@/config/sitio';

const bloques = [
  {
    t: 'La enseñanza',
    d: 'Pre-IB y el IB Diploma se imparten en inglés. Grenaa y Nyborg no cobran matrícula académica.',
    tono: 'bg-cielo',
  },
  {
    t: 'El alojamiento',
    d: 'El estudiante vive en un boarding school vinculado al centro. El internado tiene personal, normas, actividades y procesos propios. No es una habitación privada buscada por el estudiante por su cuenta.',
    tono: 'bg-menta',
  },
  {
    t: 'El coste',
    d: 'El internado sí se paga. Para menores de 18 años puede existir reducción según renta familiar. Revisamos la tarifa vigente y la documentación necesaria antes de presentar la solicitud.',
    tono: 'bg-mantequilla',
  },
  {
    t: 'La comunicación',
    d: 'Mientras el estudiante sea menor, trabajamos con la familia y el estudiante. Las decisiones que requieran intervención del representante legal se gestionan con los padres o tutores.',
    tono: 'bg-melocoton',
  },
  {
    t: 'La presencia local',
    d: `${SITIO.entidadLegal} es una empresa danesa y trabaja exclusivamente con Dinamarca. Coordinamos desde aquí las gestiones incluidas en el servicio y el acompañamiento local acordado.`,
    tono: 'bg-lavanda',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: bloques.map((b) => ({
    '@type': 'Question',
    name: `${b.t} en el IB en Dinamarca`,
    acceptedAnswer: { '@type': 'Answer', text: b.d },
  })),
};
---

<Base
  titulo="El IB en Dinamarca: guía para familias"
  tituloSeo="El IB en Dinamarca: guía para familias"
  descripcion="Qué implica que tu hijo estudie el Bachillerato Internacional en un internado danés: enseñanza, alojamiento, coste, comunicación con la familia y qué no podemos prometer."
>
  <JsonLd slot="head" datos={faqLd} />

  <section class="contenedor pb-4 pt-12 lg:pt-16">
    <CabeceraPagina
      etiqueta="Para familias"
      titulo="Tu hijo quiere estudiar el IB en Dinamarca. Empecemos por lo que necesitas saber."
    >
      <Fragment slot="titulo">Tu hijo quiere estudiar el IB en Dinamarca. Empecemos por lo que <span class="text-coral">necesitas saber.</span></Fragment>
    </CabeceraPagina>
  </section>

  <section class="contenedor ritmo">
    <ul class="grid gap-5 md:grid-cols-2">
      {bloques.map((b) => (
        <li class:list={['tarjeta-color', b.tono]}>
          <h2 class="text-h3 text-navy">{b.t}</h2>
          <p class="mt-4 text-navy/80">{b.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="no-prometemos" class="bg-navy text-white">
    <div class="contenedor py-16 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <h2 id="no-prometemos" class="text-seccion text-white">Lo que no prometemos</h2>
        <div>
          <p class="max-w-prosa text-lg text-white/85">
            La admisión la decide el colegio. La disponibilidad del internado también
            depende del centro. Y cualquier figura formal de contacto local o
            representación del menor debe cumplir las reglas específicas del colegio.
          </p>
          <p class="mt-6 max-w-prosa text-lg text-white/85">
            Preferimos explicar exactamente cómo funciona a convertir una cuestión seria
            en una frase de marketing.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="contenedor ritmo">
    <div class="grid gap-8 sm:grid-cols-3">
      <a href={ruta('/bachillerato-internacional/costes/')} class="tarjeta tarjeta-hover p-6">
        <p class="etiqueta-suelta text-azul-700">Costes</p>
        <p class="mt-3 text-h3 text-navy">Qué se paga y qué no</p>
      </a>
      <a href={ruta('/bachillerato-internacional/admision/')} class="tarjeta tarjeta-hover p-6">
        <p class="etiqueta-suelta text-azul-700">Admisión</p>
        <p class="mt-3 text-h3 text-navy">Cómo es el proceso</p>
      </a>
      <a href={ruta('/bachillerato-internacional/')} class="tarjeta tarjeta-hover p-6">
        <p class="etiqueta-suelta text-azul-700">Los centros</p>
        <p class="mt-3 text-h3 text-navy">Grenaa y Nyborg</p>
      </a>
    </div>
  </section>

  <CtaFinal
    etiqueta=""
    titulo="¿Hablamos antes de decidir nada?"
    texto="La primera sesión es gratuita y sin compromiso. Revisamos el expediente del estudiante, los plazos y qué supondría el proceso para vuestra familia."
    cta="Reservar una primera sesión"
  />
</Base>
