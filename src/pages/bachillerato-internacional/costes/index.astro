---
import Base from '@/layouts/Base.astro';
import CabeceraPagina from '@/components/CabeceraPagina.astro';
import CtaFinal from '@/components/CtaFinal.astro';
import { ruta } from '@/lib/ruta';
import { SITIO } from '@/config/sitio';

const eur = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
---

<Base
  titulo="Cuánto cuesta el IB en Dinamarca"
  tituloSeo="Cuánto cuesta el IB en Dinamarca"
  descripcion="La matrícula académica de Pre-IB y el IB Diploma en Grenaa y Nyborg es 0 €. El coste principal para una familia es el internado, con reducciones según renta para menores de 18 años."
>
  <section class="contenedor pb-4 pt-12 lg:pt-16">
    <CabeceraPagina
      etiqueta="Cuánto cuesta"
      titulo="La matrícula académica es 0 €. El internado se paga aparte."
      lead="Grenaa y Nyborg son centros públicos y no cobran tuition fee por estudiar Pre-IB o el IB Diploma. El coste principal para una familia es el boarding school."
    >
      <Fragment slot="titulo">La matrícula académica es <span class="text-coral">0 €.</span> El internado se paga aparte.</Fragment>
    </CabeceraPagina>
  </section>

  <section class="contenedor ritmo">
    <section aria-labelledby="menores">
      <h2 id="menores" class="text-h2 text-navy">Si el estudiante es menor de 18 años</h2>
      <p class="mt-5 max-w-prosa text-lg text-slate">
        Ambos centros contemplan reducciones relacionadas con la renta familiar. La
        fórmula, la documentación y el año fiscal utilizado dependen del centro y del
        curso de entrada.
      </p>
    </section>

    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="tarjeta-color bg-mantequilla">
        <p class="pastilla">Ejemplo</p>
        <h3 class="mt-3 text-h3 text-navy">Nyborg</h3>
        <p class="mt-4 text-navy/80">
          En la tarifa actualmente publicada, un menor de 18 años parte de
          <strong class="font-bold text-navy">27.000 DKK anuales</strong> y se añade el
          4,5 % de la renta familiar bruta que exceda 100.000 DKK, hasta un máximo de
          50.000 DKK. Existe además una tasa de inscripción al internado de 2.500 DKK.
        </p>
        <p class="mt-4 text-sm text-navy/70">Estos importes se actualizan anualmente.</p>
      </div>

      <div class="tarjeta-color bg-cielo">
        <p class="pastilla">Ejemplo</p>
        <h3 class="mt-3 text-h3 text-navy">Grenaa</h3>
        <p class="mt-4 text-navy/80">
          Grenaa calcula la posible reducción a partir de la renta documentada y
          determinadas circunstancias familiares. Para 2026/27 utiliza información de
          ingresos de 2024.
        </p>
        <p class="mt-4 text-navy/80">
          El <em>boarding fee</em> cubre pensión completa, alojamiento, internet y uso
          de instalaciones.
        </p>
      </div>
    </div>

    <section aria-labelledby="nuestro" class="mt-16">
      <h2 id="nuestro" class="text-h2 text-navy">Nuestro servicio</h2>
      <p class="mt-5 max-w-prosa text-lg text-slate">
        El servicio de {SITIO.nombre} cuesta
        <strong class="font-bold text-navy">{eur(SITIO.precioIB)} € IVA incluido</strong>.
      </p>
      <div class="bloque-condicion mt-7 max-w-prosa">
        El <em>boarding fee</em>, viajes, seguros, tasas externas, material y otros
        gastos personales se pagan aparte.
      </div>
      <a href={ruta('/contacto/')} class="cta mt-8">Calcular mi situación <span aria-hidden="true">→</span></a>
    </section>
  </section>

  <CtaFinal
    etiqueta=""
    titulo="¿Hacemos números con tu caso?"
    texto="Las tarifas cambian cada curso y la reducción depende de la renta documentada. En la primera sesión revisamos la tarifa vigente y qué documentación pide cada centro."
    cta="Reservar primera sesión"
  />
</Base>
