---
import Base from '@/layouts/Base.astro';
import CabeceraPagina from '@/components/CabeceraPagina.astro';
import CtaFinal from '@/components/CtaFinal.astro';
import Icono from '@/components/Icono.astro';
import { ruta } from '@/lib/ruta';

const datos = [
  ['Matrícula académica', '0 €'],
  ['Programas', 'Pre-IB + IB Diploma'],
  ['Idioma', 'Inglés'],
  ['Alojamiento', 'Habitación individual'],
  ['Dónde', 'Nyborg, Fionia'],
];
---

<Base
  titulo="Nyborg Gymnasium"
  tituloSeo="Nyborg Gymnasium: Pre-IB e IB en Dinamarca"
  descripcion="Pre-IB e IB Diploma en inglés, internado en el propio campus con habitación individual y 0 € de matrícula académica, en una comunidad de estudiantes de más de 40 países."
>
  <section class="contenedor pb-4 pt-12 lg:pt-16">
    <CabeceraPagina
      etiqueta="Nyborg Gymnasium"
      titulo="Estudia el IB en una comunidad de más de 40 países."
      lead="Pre-IB e IB Diploma en inglés, internado en el propio campus y 0 € de matrícula académica."
    >
      <Fragment slot="titulo">Estudia el IB en una comunidad de más de <span class="text-coral">40 países.</span></Fragment>
    </CabeceraPagina>
  </section>

  <section class="contenedor mt-10">
    <dl class="ficha-datos max-w-2xl rounded-tarjeta border-navy/10 bg-mantequilla px-6 py-2 divide-navy/10">
      {datos.map(([k, v]) => (
        <div><dt class="text-navy/70">{k}</dt><dd>{v}</dd></div>
      ))}
    </dl>
  </section>

  <section class="contenedor ritmo">
    <div class="grid gap-x-16 gap-y-12 lg:grid-cols-2">
      <div>
        <h2 class="text-h2 text-navy">El programa</h2>
        <p class="mt-5 max-w-prosa text-lg text-slate">
          Nyborg ofrece un Pre-IB de un año y el Diploma Programme de dos años. Los
          candidatos internacionales se evalúan a partir de su formación previa, notas,
          motivación y referencia del colegio. El centro puede utilizar entrevista o
          pruebas para aclarar el nivel de entrada.
        </p>
      </div>

      <div>
        <h2 class="text-h2 text-navy">El internado</h2>
        <p class="mt-5 max-w-prosa text-lg text-slate">
          Casi la mitad de los estudiantes de Pre-IB e IB viven en el
          <em>boarding school</em>. Los residentes disponen de habitación individual y
          acceso a actividades después de clase. Para menores de 18 años, el coste puede
          reducirse en función de la renta familiar.
        </p>
      </div>

      <div>
        <h2 class="text-h2 text-navy">Cómo se solicita</h2>
        <p class="mt-5 max-w-prosa text-lg text-slate">
          Pre-IB, IB y <em>boarding school</em> tienen formularios específicos. La
          solicitud al internado es separada de la solicitud académica. Los plazos deben
          comprobarse para cada curso; Nyborg publica actualmente el
          <strong class="font-bold text-navy">1 de febrero</strong> para estas
          candidaturas.
        </p>
      </div>

      <div>
        <h2 class="text-h2 text-navy">Contacto local</h2>
        <p class="mt-5 max-w-prosa text-lg text-slate">
          Nyborg exige que los <em>boarders</em> tengan una persona de contacto en
          Dinamarca. La figura debe cumplir las condiciones del centro.
        </p>
        <div class="bloque-condicion mt-6 max-w-prosa">
          Study &amp; Beyond coordina con la familia qué solución válida corresponde en
          cada caso, y no presenta este requisito como una tutela automática.
        </div>
        <a href={ruta('/contacto/')} class="enlace mt-7">
          Revisar mi perfil para Nyborg <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <p class="mt-14 flex max-w-prosa items-start gap-2.5 text-sm text-slate">
      <Icono nombre="pin" class="mt-0.5 h-4 w-4 shrink-0 text-coral" />
      <span>
        Requisitos, plazos y tarifas los publica el centro y cambian cada curso.
        Antes de solicitar, comprobamos contigo la información vigente.
        <a href={ruta('/bachillerato-internacional/costes/')} class="link-sub">Ver los costes</a>.
      </span>
    </p>
  </section>

  <CtaFinal
    etiqueta=""
    titulo="¿Encaja Nyborg con tu perfil?"
    texto="La primera sesión es gratuita. Revisamos tu expediente, tu nivel de inglés y si te corresponde Pre-IB o acceso directo a IB1."
    cta="Reservar primera sesión"
  />
</Base>
