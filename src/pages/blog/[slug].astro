---
import { getCollection, render } from 'astro:content';
import { ruta } from '@/lib/ruta';
import Base from '@/layouts/Base.astro';
import CtaFinal from '@/components/CtaFinal.astro';
import JsonLd from '@/components/JsonLd.astro';
import { SITIO } from '@/config/sitio';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.borrador);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const fechaLarga = new Date(d.fecha + 'T00:00:00').toLocaleDateString('es-ES', {
  day: 'numeric', month: 'long', year: 'numeric',
});

const url = `${SITIO.dominio}/blog/${post.id}/`;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.titulo,
  description: d.descripcion,
  datePublished: d.fecha,
  inLanguage: 'es-ES',
  keywords: d.etiquetas.join(', '),
  author: { '@type': 'Organization', name: d.autor, url: SITIO.dominio },
  publisher: {
    '@type': 'Organization',
    name: SITIO.entidadLegal,
    logo: { '@type': 'ImageObject', url: new URL('/og/default.png', SITIO.dominio).href },
  },
  mainEntityOfPage: url,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITIO.dominio + '/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITIO.dominio}/blog/` },
    { '@type': 'ListItem', position: 3, name: d.titulo, item: url },
  ],
};

const faqLd = d.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faq.map((f) => ({
        '@type': 'Question',
        name: f.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
      })),
    }
  : null;

const datosLd = [articleLd, breadcrumbLd, ...(faqLd ? [faqLd] : [])];
---

<Base titulo={d.titulo} descripcion={d.descripcion} tipoOg="article">
  <JsonLd slot="head" datos={datosLd} />

  <article class="contenedor py-12 lg:py-16">
    <nav aria-label="Migas de pan" class="mb-6 text-sm font-bold text-slate">
      <a href={ruta("/blog/")} class="hover:text-navy">Blog</a>
    </nav>
    <header class="max-w-3xl">
      <time datetime={d.fecha} class="fecha-mono text-xs text-slate">{fechaLarga}</time>
      <h1 class="mt-3 text-titulo text-navy">{d.titulo}</h1>
      <p class="mt-5 max-w-prosa text-lg text-slate">{d.descripcion}</p>
    </header>

    {d.imagen && (
      <img
        src={ruta(`/img/${d.imagen}-${d.imagenAnchos[d.imagenAnchos.length - 1]}.webp`)}
        srcset={d.imagenAnchos.map((a) => `${ruta(`/img/${d.imagen}-${a}.webp`)} ${a}w`).join(', ')}
        sizes="(min-width: 1024px) 70vw, 100vw"
        alt={d.imagenAlt}
        loading="lazy"
        decoding="async"
        class="mt-9 aspect-[2/1] max-h-[380px] w-full rounded-imagen object-cover"
      />
    )}

    <div class="contenido-mdx mt-10">
      <Content />
    </div>
  </article>

  <CtaFinal
    titulo="¿Quieres saber qué opciones tienes en Dinamarca?"
    texto="La primera sesión es gratuita. Revisamos tu situación, qué grados pueden encajar y cómo sería el proceso en tu caso."
  />
</Base>
