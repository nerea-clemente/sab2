---
// Logotipo: cuadrado redondeado azul con la chispa blanca y el punto amarillo,
// más el nombre en dos líneas apretadas. Es el único bloque que combina el
// azul de acción con el amarillo, y solo aquí.
interface Props {
  claro?: boolean; // sobre fondo navy
  class?: string;
}
const { claro = false, class: clase = '' } = Astro.props;
---

<span class:list={['flex items-center gap-3', clase]}>
  <span
    class:list={[
      'relative flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px]',
      claro ? 'bg-white' : 'bg-azul',
    ]}
    aria-hidden="true"
  >
    <svg viewBox="0 0 24 24" class="h-[22px] w-[22px]" aria-hidden="true">
      <path
        d="M12 3c.7 4.6 3.2 7.1 7.8 7.8-4.6.7-7.1 3.2-7.8 7.8-.7-4.6-3.2-7.1-7.8-7.8C8.8 10.1 11.3 7.6 12 3Z"
        fill={claro ? '#1358E0' : '#FFFFFF'}
      />
    </svg>
    <span
      class:list={[
        'absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full bg-amarillo ring-2',
        claro ? 'ring-navy' : 'ring-crema',
      ]}
    ></span>
  </span>
  <span
    class:list={[
      'font-display text-[15px] font-extrabold leading-[1.08] tracking-[-0.02em] sm:text-base',
      claro ? 'text-white' : 'text-navy',
    ]}
  >Study &amp;<br />Beyond</span>
</span>
