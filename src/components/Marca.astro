---
import { ISOTIPO_D, ISOTIPO_RADIO } from '@/lib/marca';

// Logotipo: isotipo (dos eslabones entrelazados) en cuadrado redondeado azul,
// más el nombre en dos líneas apretadas. Sobre fondo oscuro se invierte:
// cuadrado blanco con el isotipo en azul.
interface Props {
  claro?: boolean; // sobre fondo navy
  class?: string;
}
const { claro = false, class: clase = '' } = Astro.props;
---

<span class:list={['flex items-center gap-3', clase]}>
  <svg
    viewBox="0 0 100 100"
    class="h-10 w-10 shrink-0"
    role="img"
    aria-label="Study & Beyond"
  >
    <rect width="100" height="100" rx={ISOTIPO_RADIO} fill={claro ? '#FFFFFF' : '#1358E0'} />
    <path fill={claro ? '#1358E0' : '#FFFFFF'} d={ISOTIPO_D} />
  </svg>
  <span
    class:list={[
      'font-display text-[15px] font-extrabold leading-[1.08] tracking-[-0.02em] sm:text-base',
      claro ? 'text-white' : 'text-navy',
    ]}
  >Study &amp;<br />Beyond</span>
</span>
