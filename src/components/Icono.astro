  personas: 'M16 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 18.5V20M10 11.5a3.25 3.25 0 1 0 0-6.5 3.25 3.25 0 0 0 0 6.5ZM20 20v-1.5a3.5 3.5 0 0 0-2.6-3.38M15.5 5.2a3.25 3.25 0 0 1 0 6.1',
  chispa: 'M12 3.5c.7 4.6 3.2 7.1 7.8 7.8-4.6.7-7.1 3.2-7.8 7.8-.7-4.6-3.2-7.1-7.8-7.8 4.6-.7 7.1-3.2 7.8-7.8Z',
  libro: 'M4 5.5A1.5 1.5 0 0 1 5.5 4H10a2.5 2.5 0 0 1 2 1 2.5 2.5 0 0 1 2-1h4.5A1.5 1.5 0 0 1 20 5.5v12a1.5 1.5 0 0 1-1.5 1.5H14a2.5 2.5 0 0 0-2 1 2.5 2.5 0 0 0-2-1H5.5A1.5 1.5 0 0 1 4 17.5v-12ZM12 5v14',
  bici: 'M6 19.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm12 0a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM6 16h5l3.5-8M11 8h5m-3.5 0 3.3 8M9 8h4',
  birrete: 'M12 4 2.5 9 12 14l9.5-5L12 4Zm6.5 7.5v4.2c0 .6-.3 1.1-.8 1.4-1.3.8-3.2 1.4-5.7 1.4s-4.4-.6-5.7-1.4a1.6 1.6 0 0 1-.8-1.4v-4.2',
  check: 'm4.5 12.5 5 5 10-11',
  pin: 'M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Zm0-8.2a2.8 2.8 0 1 0 0-5.6 2.8 2.8 0 0 0 0 5.6Z',
  flecha: 'M5 12h14m-6-6 6 6-6 6',
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={[clase]}
  aria-hidden="true"
><path d={trazos[nombre]} /></svg>
