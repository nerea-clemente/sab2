---
// Juego de iconos de línea de la marca: trazo de 1.75, extremos redondeados y
// formas simples. Se usan en la banda amarilla, en las tarjetas de área y en
// las listas de la portada. Nunca decorativos por decorar: acompañan siempre a
// un rótulo, por eso van marcados como aria-hidden.
interface Props {
  nombre:
    | 'maletin'
    | 'capas'
    | 'personas'
    | 'chispa'
    | 'libro'
    | 'bici'
    | 'birrete'
    | 'check'
    | 'pin'
    | 'flecha';
  class?: string;
}
const { nombre, class: clase = 'h-5 w-5' } = Astro.props;

const trazos: Record<Props['nombre'], string> = {
