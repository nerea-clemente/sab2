---
import { ruta } from '@/lib/ruta';

// Módulo de artículos: rejilla de tarjetas con foto, rótulo, titular y entrada.
// Se usa al pie de las fichas de grado y sirve para cualquier otra página que
// necesite enlazar a contenido del blog o de las guías.
export type ItemArticulo = {
  rotulo?: string;
  titulo: string;
  descripcion: string;
  href: string;
  imagen: string | null;
};

interface Props {
  items: readonly ItemArticulo[];
  titulo?: string;
  lead?: string;
  id?: string;
  verTodo?: { texto: string; href: string };
  class?: string;
}
const { items, titulo, lead, id = 'articulos', verTodo, class: clase = '' } = Astro.props;
---

{items.length > 0 && (
  <section aria-labelledby={id} class:list={[clase]}>
    {titulo && <h2 id={id} class="text-h2 text-navy">{titulo}</h2>}
    {lead && <p class="prosa mt-4 text-lg">{lead}</p>}

    <ul class:list={['grid gap-5 sm:grid-cols-2 lg:grid-cols-3', titulo || lead ? 'mt-9' : '']}>
      {items.map((a) => (
        <li>
          <a
            href={ruta(a.href)}
            class="tarjeta-color group h-full overflow-hidden border border-hairline bg-papel !p-0"
          >
            {a.imagen && (
              <img
                src={ruta(`/img/${a.imagen}-640.webp`)}
                alt=""
                width="640"
                height="427"
                loading="lazy"
                decoding="async"
                class="aspect-[3/2] w-full object-cover"
              />
            )}
            <div class="flex flex-1 flex-col p-6">
              {a.rotulo && <p class="etiqueta-suelta text-coral">{a.rotulo}</p>}
              <h3 class:list={['text-h3 text-navy', a.rotulo ? 'mt-3' : '']}>{a.titulo}</h3>
              <p class="mt-2.5 text-sm text-slate">{a.descripcion}</p>
              <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-extrabold text-azul">
                Leer
                <span class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    {verTodo && (
      <a href={ruta(verTodo.href)} class="enlace mt-9">
        {verTodo.texto} <span aria-hidden="true">→</span>
      </a>
    )}
  </section>
)}
